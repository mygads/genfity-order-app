{
  "expo": {
    "name": "Genfity Order",
    "slug": "genfity-order-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "id.genfity.posclone",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Genfity Order mengakses galeri untuk melampirkan foto bukti kas kecil.",
          "cameraPermission": "Izinkan Genfity Order memakai kamera untuk memotret bukti kas kecil."
        }
      ],
      "./modules/genfity-printer/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "067c7c8e-1fcd-4c7b-9380-055bfd242cd9"
      }
    }
  }
}
