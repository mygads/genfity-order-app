{
  "expo": {
    "name": "Genfity POS",
    "slug": "genfity-order-app",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.genfity.pos"
    },
    "android": {
      "package": "id.genfity.pos",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-genfity.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Genfity POS mengakses galeri untuk melampirkan foto bukti kas kecil.",
          "cameraPermission": "Izinkan Genfity POS memakai kamera untuk memotret bukti kas kecil."
        }
      ],
      "./modules/genfity-printer/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "067c7c8e-1fcd-4c7b-9380-055bfd242cd9"
      }
    }
  }
}
